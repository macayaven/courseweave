{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://courseweave.local/schema/courseweave-v1.json",
  "title": "CourseWeave course manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "description", "entry_module_id", "policies", "modules"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"$ref": "#/$defs/slug"},
    "title": {"$ref": "#/$defs/nonEmpty"},
    "description": {"type": "string"},
    "entry_module_id": {"oneOf": [{"$ref": "#/$defs/slug"}, {"type": "null"}]},
    "policies": {"$ref": "#/$defs/policies"},
    "modules": {"type": "array", "items": {"$ref": "#/$defs/module"}}
  },
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "nonEmpty": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240,
      "pattern": ".*\\S.*"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/])(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "role": {"enum": ["primary", "reference", "exercise", "evidence"]},
    "policies": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "content_sharing",
        "durable_mutation",
        "terminal_execution",
        "conversation_memory",
        "max_shared_chars",
        "workspace_write_globs"
      ],
      "properties": {
        "content_sharing": {"const": "explicit_only"},
        "durable_mutation": {"const": "proposal_or_direct_student_action"},
        "terminal_execution": {"const": "student_only"},
        "conversation_memory": {"const": "session_only"},
        "max_shared_chars": {"type": "integer", "minimum": 1, "maximum": 131072},
        "workspace_write_globs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 1024}
        }
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "phases"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "title": {"$ref": "#/$defs/nonEmpty"},
        "description": {"type": "string"},
        "phases": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/phase"}
        }
      }
    },
    "phase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "kind", "teacher_mode", "surfaces", "completion", "capabilities"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "title": {"$ref": "#/$defs/nonEmpty"},
        "kind": {"enum": ["orient", "read", "watch", "predict", "experiment", "lab", "review", "audit", "ship"]},
        "teacher_mode": {"enum": ["orienter", "reading_companion", "socratic_guide", "debugging_coach", "reviewer", "observer", "curriculum_designer"]},
        "surfaces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/surface"}},
        "completion": {"$ref": "#/$defs/completion"},
        "capabilities": {"$ref": "#/$defs/capabilities"}
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chat",
        "hint_level",
        "share_selection",
        "share_cell",
        "share_output",
        "create_profile_proposal",
        "create_course_proposal",
        "create_workspace_proposal"
      ],
      "properties": {
        "chat": {"type": "boolean"},
        "hint_level": {"enum": ["none", "gentle", "graduated", "full"]},
        "share_selection": {"type": "boolean"},
        "share_cell": {"type": "boolean"},
        "share_output": {"type": "boolean"},
        "create_profile_proposal": {"type": "boolean"},
        "create_course_proposal": {"type": "boolean"},
        "create_workspace_proposal": {"type": "boolean"}
      }
    },
    "completion": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type"],
          "properties": {"type": {"const": "manual"}}
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "record_id"],
          "properties": {
            "type": {"enum": ["prediction_recorded", "receipt_recorded"]},
            "record_id": {"$ref": "#/$defs/slug"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "record_id", "path"],
          "properties": {
            "type": {"const": "artifact_exists"},
            "record_id": {"$ref": "#/$defs/slug"},
            "path": {"$ref": "#/$defs/relativePath"}
          }
        }
      ]
    },
    "localSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "type": {"enum": ["html", "markdown", "source"]},
        "role": {"$ref": "#/$defs/role"},
        "path": {"$ref": "#/$defs/relativePath"}
      }
    },
    "notebookSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "type": {"const": "notebook"},
        "role": {"$ref": "#/$defs/role"},
        "path": {"$ref": "#/$defs/relativePath"},
        "match": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "cell_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 160}
            },
            "cell_tags": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1, "maxLength": 160}
            }
          }
        }
      }
    },
    "videoLocal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "path"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "type": {"const": "video"},
        "role": {"$ref": "#/$defs/role"},
        "path": {"$ref": "#/$defs/relativePath"},
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "videoRemote": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "url"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "type": {"const": "video"},
        "role": {"$ref": "#/$defs/role"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "start_seconds": {"type": "number", "minimum": 0},
        "end_seconds": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "terminalSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "label", "argv", "cwd"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "type": {"const": "terminal"},
        "role": {"$ref": "#/$defs/role"},
        "label": {"$ref": "#/$defs/nonEmpty"},
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1, "maxLength": 2048}
        },
        "cwd": {"$ref": "#/$defs/relativePath"}
      }
    },
    "externalSurface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "role", "url"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "type": {"const": "external"},
        "role": {"$ref": "#/$defs/role"},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"}
      }
    },
    "surface": {
      "oneOf": [
        {"$ref": "#/$defs/localSurface"},
        {"$ref": "#/$defs/notebookSurface"},
        {"$ref": "#/$defs/videoLocal"},
        {"$ref": "#/$defs/videoRemote"},
        {"$ref": "#/$defs/terminalSurface"},
        {"$ref": "#/$defs/externalSurface"}
      ]
    }
  }
}
