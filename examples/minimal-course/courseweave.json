{
  "schema_version": 2,
  "id": "minimal-course",
  "title": "Minimal Course",
  "description": "The smallest runnable CourseWeave course.",
  "entry_module_id": "start",
  "policies": {
    "content_sharing": "explicit_only",
    "allowed_share_kinds": [
      "selection"
    ],
    "max_shared_chars": 8192,
    "allowed_proposal_types": [],
    "durable_mutation": "proposal_or_direct_student_action",
    "terminal_execution": "student_only",
    "conversation_memory": "session_only",
    "workspace_write_globs": []
  },
  "modules": [
    {
      "id": "start",
      "title": "Start",
      "description": "",
      "phases": [
        {
          "id": "read",
          "title": "Read the lesson",
          "progress": "required",
          "experience": {
            "type": "builtin",
            "id": "reading"
          },
          "surfaces": [
            {
              "id": "lesson",
              "purpose": "primary",
              "type": "markdown",
              "label": "lesson",
              "path": "lesson.md"
            }
          ],
          "completion": {
            "requirements": [
              {
                "id": "acknowledgement",
                "type": "learner_record",
                "record_kind": "attestation",
                "prompt": "Confirm completion of Read the lesson."
              }
            ]
          },
          "teacher": {
            "access": {
              "mode": "available",
              "requires": []
            },
            "guidance": {
              "style": {
                "type": "builtin",
                "id": "explanatory"
              },
              "hint_level": "gentle"
            },
            "sharing": {
              "allow": [
                "selection"
              ]
            },
            "proposals": {
              "allow": []
            }
          }
        }
      ]
    }
  ]
}
