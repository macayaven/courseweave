{
  "name": "@courseweave/lab",
  "version": "0.1.0",
  "private": true,
  "description": "CourseWeave JupyterLab prebuilt bridge: one sandboxed guide iframe, no React.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -b .",
    "build:lib": "tsc -b .",
    "build:labextension": "uv run --frozen jupyter-builder build .",
    "build": "tsc -b . && uv run --frozen jupyter-builder build ."
  },
  "dependencies": {
    "@jupyterlab/application": "~4.6.3",
    "@jupyterlab/coreutils": "~6.6.3",
    "@jupyterlab/docmanager": "~4.6.3",
    "@jupyterlab/fileeditor": "~4.6.3",
    "@jupyterlab/notebook": "~4.6.3",
    "@jupyterlab/services": "~7.6.3",
    "@jupyterlab/settingregistry": "~4.6.3",
    "@jupyterlab/terminal": "~4.6.3",
    "@lumino/widgets": "~2.8.0"
  },
  "devDependencies": {
    "@jupyter/builder": "~1.2.2",
    "@jupyterlab/core-meta": "~4.6.3",
    "jsdom": "26.1.0",
    "vitest": "4.1.11"
  },
  "jupyterlab": {
    "extension": true,
    "schemaDir": "schema",
    "webpackConfig": "webpack.config.cjs",
    "outputDir": "../../../src/courseweave/labextension",
    "_build": {
      "load": "static/remoteEntry.e339005fd991b255.js",
      "extension": "./extension"
    }
  }
}
