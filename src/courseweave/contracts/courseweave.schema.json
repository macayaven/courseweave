{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$defs": {
    "ArtifactExistsRequirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "artifact_exists",
          "title": "Type",
          "type": "string"
        },
        "prompt": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Prompt",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?!/)(?![\\s\\S]*[:\\\\\\x00-\\x1f\\x7f])(?![\\s\\S]*(?:^|/)(?:\\.{1,2})(?:/|$))[^/]+(?:/[^/]+)*(?![\\s\\S])",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "prompt",
        "path"
      ],
      "title": "ArtifactExistsRequirement",
      "type": "object"
    },
    "BuiltinExperience": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "builtin",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "enum": [
            "generic",
            "orientation",
            "reading",
            "media",
            "prediction",
            "experiment",
            "practice",
            "review",
            "project"
          ],
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "BuiltinExperience",
      "type": "object"
    },
    "BuiltinTeacherStyle": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "builtin",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "enum": [
            "orienting",
            "explanatory",
            "socratic",
            "debugging",
            "reviewing"
          ],
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "BuiltinTeacherStyle",
      "type": "object"
    },
    "CellIdsSelector": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cell_ids",
          "title": "Type",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_-]+(?![\\s\\S])",
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        }
      },
      "required": [
        "type",
        "values"
      ],
      "title": "CellIdsSelector",
      "type": "object"
    },
    "CellTagsSelector": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "cell_tags",
          "title": "Type",
          "type": "string"
        },
        "values": {
          "items": {
            "maxLength": 160,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 256,
          "minItems": 1,
          "title": "Values",
          "type": "array"
        },
        "match": {
          "enum": [
            "any",
            "all"
          ],
          "title": "Match",
          "type": "string"
        }
      },
      "required": [
        "type",
        "values",
        "match"
      ],
      "title": "CellTagsSelector",
      "type": "object"
    },
    "CheckOption": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Text",
          "type": "string"
        },
        "feedback": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Feedback",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text",
        "feedback"
      ],
      "title": "CheckOption",
      "type": "object"
    },
    "Completion": {
      "additionalProperties": false,
      "properties": {
        "requirements": {
          "items": {
            "discriminator": {
              "mapping": {
                "artifact_exists": "#/$defs/ArtifactExistsRequirement",
                "learner_record": "#/$defs/LearnerRecordRequirement"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/LearnerRecordRequirement"
              },
              {
                "$ref": "#/$defs/ArtifactExistsRequirement"
              }
            ]
          },
          "maxItems": 64,
          "title": "Requirements",
          "type": "array"
        }
      },
      "required": [
        "requirements"
      ],
      "title": "Completion",
      "type": "object"
    },
    "CoursePolicies": {
      "additionalProperties": false,
      "properties": {
        "content_sharing": {
          "const": "explicit_only",
          "title": "Content Sharing",
          "type": "string"
        },
        "allowed_share_kinds": {
          "items": {
            "enum": [
              "selection",
              "cell",
              "output"
            ],
            "type": "string"
          },
          "title": "Allowed Share Kinds",
          "type": "array"
        },
        "max_shared_chars": {
          "maximum": 131072,
          "minimum": 1,
          "title": "Max Shared Chars",
          "type": "integer"
        },
        "allowed_proposal_types": {
          "items": {
            "enum": [
              "profile",
              "course",
              "workspace"
            ],
            "type": "string"
          },
          "title": "Allowed Proposal Types",
          "type": "array"
        },
        "durable_mutation": {
          "const": "proposal_or_direct_student_action",
          "title": "Durable Mutation",
          "type": "string"
        },
        "terminal_execution": {
          "const": "student_only",
          "title": "Terminal Execution",
          "type": "string"
        },
        "conversation_memory": {
          "const": "session_only",
          "title": "Conversation Memory",
          "type": "string"
        },
        "workspace_write_globs": {
          "items": {
            "maxLength": 1024,
            "minLength": 1,
            "pattern": "^(?![!])(?![\\s\\S]*[{}])^(?!/)(?![\\s\\S]*[:\\\\\\x00-\\x1f\\x7f])(?![\\s\\S]*(?:^|/)(?:\\.{1,2})(?:/|$))[^/]+(?:/[^/]+)*(?![\\s\\S])",
            "type": "string"
          },
          "maxItems": 128,
          "title": "Workspace Write Globs",
          "type": "array"
        }
      },
      "required": [
        "content_sharing",
        "allowed_share_kinds",
        "max_shared_chars",
        "allowed_proposal_types",
        "durable_mutation",
        "terminal_execution",
        "conversation_memory",
        "workspace_write_globs"
      ],
      "title": "CoursePolicies",
      "type": "object"
    },
    "CustomExperience": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "custom",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+/[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "CustomExperience",
      "type": "object"
    },
    "CustomTeacherStyle": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "custom",
          "title": "Type",
          "type": "string"
        },
        "id": {
          "maxLength": 160,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:[.-][a-z0-9]+)+/[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        }
      },
      "required": [
        "type",
        "id"
      ],
      "title": "CustomTeacherStyle",
      "type": "object"
    },
    "Duration": {
      "additionalProperties": false,
      "properties": {
        "min_minutes": {
          "maximum": 1440,
          "minimum": 1,
          "title": "Min Minutes",
          "type": "integer"
        },
        "max_minutes": {
          "maximum": 1440,
          "minimum": 1,
          "title": "Max Minutes",
          "type": "integer"
        }
      },
      "required": [
        "min_minutes",
        "max_minutes"
      ],
      "title": "Duration",
      "type": "object"
    },
    "ExternalSurface": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "primary",
            "supporting",
            "reference"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "type": {
          "const": "external",
          "title": "Type",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Label",
          "type": "string"
        },
        "url": {
          "format": "uri",
          "maxLength": 2048,
          "minLength": 1,
          "pattern": "^(?![\\s\\S]*[\\x00-\\x20\\x7f\\\\])https://(?![^/?#]*@)(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]+)?(?:[/?#][\\s\\S]*)?(?![\\s\\S])",
          "title": "Url",
          "type": "string"
        }
      },
      "required": [
        "id",
        "purpose",
        "type",
        "label",
        "url"
      ],
      "title": "ExternalSurface",
      "type": "object"
    },
    "Hint": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Text",
          "type": "string"
        },
        "objective_ids": {
          "default": [],
          "items": {
            "maxLength": 80,
            "minLength": 1,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
            "type": "string"
          },
          "maxItems": 32,
          "title": "Objective Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Hint",
      "type": "object"
    },
    "HtmlSurface": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "primary",
            "supporting",
            "reference"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "type": {
          "const": "html",
          "title": "Type",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Label",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?!/)(?![\\s\\S]*[:\\\\\\x00-\\x1f\\x7f])(?![\\s\\S]*(?:^|/)(?:\\.{1,2})(?:/|$))[^/]+(?:/[^/]+)*(?![\\s\\S])",
          "title": "Path",
          "type": "string"
        },
        "fragment": {
          "anyOf": [
            {
              "maxLength": 160,
              "minLength": 1,
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*(?![\\s\\S])",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fragment"
        }
      },
      "required": [
        "id",
        "purpose",
        "type",
        "label",
        "path"
      ],
      "title": "HtmlSurface",
      "type": "object"
    },
    "JupyterKernel": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "python_uv_project",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "type"
      ],
      "title": "JupyterKernel",
      "type": "object"
    },
    "JupyterRuntime": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "jupyter",
          "title": "Type",
          "type": "string"
        },
        "kernel": {
          "$ref": "#/$defs/JupyterKernel"
        }
      },
      "required": [
        "type",
        "kernel"
      ],
      "title": "JupyterRuntime",
      "type": "object"
    },
    "LearnerRecordRequirement": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "const": "learner_record",
          "title": "Type",
          "type": "string"
        },
        "record_kind": {
          "enum": [
            "text",
            "evidence",
            "attestation"
          ],
          "title": "Record Kind",
          "type": "string"
        },
        "prompt": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Prompt",
          "type": "string"
        }
      },
      "required": [
        "id",
        "type",
        "record_kind",
        "prompt"
      ],
      "title": "LearnerRecordRequirement",
      "type": "object"
    },
    "Learning": {
      "additionalProperties": false,
      "description": "Authored teaching metadata. Checks never confer completion or certification.\n\nHints are progressive in array order. Correct IDs/feedback are author data,\nnot suitable for unfiltered pre-attempt provider context.",
      "properties": {
        "objectives": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Objective"
          },
          "maxItems": 32,
          "title": "Objectives",
          "type": "array"
        },
        "duration": {
          "anyOf": [
            {
              "$ref": "#/$defs/Duration"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "overview": {
          "anyOf": [
            {
              "maxLength": 8000,
              "minLength": 1,
              "pattern": ".*\\S.*",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overview"
        },
        "hints": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Hint"
          },
          "maxItems": 20,
          "title": "Hints",
          "type": "array"
        },
        "sources": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SourceReference"
          },
          "maxItems": 32,
          "title": "Sources",
          "type": "array"
        },
        "checks": {
          "default": [],
          "items": {
            "$ref": "#/$defs/SingleChoiceCheck"
          },
          "maxItems": 32,
          "title": "Checks",
          "type": "array"
        }
      },
      "title": "Learning",
      "type": "object"
    },
    "MarkdownSurface": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "primary",
            "supporting",
            "reference"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "type": {
          "const": "markdown",
          "title": "Type",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Label",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?!/)(?![\\s\\S]*[:\\\\\\x00-\\x1f\\x7f])(?![\\s\\S]*(?:^|/)(?:\\.{1,2})(?:/|$))[^/]+(?:/[^/]+)*(?![\\s\\S])",
          "title": "Path",
          "type": "string"
        }
      },
      "required": [
        "id",
        "purpose",
        "type",
        "label",
        "path"
      ],
      "title": "MarkdownSurface",
      "type": "object"
    },
    "Module": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Title",
          "type": "string"
        },
        "description": {
          "maxLength": 4000,
          "title": "Description",
          "type": "string"
        },
        "phases": {
          "items": {
            "$ref": "#/$defs/Phase"
          },
          "maxItems": 256,
          "title": "Phases",
          "type": "array"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "phases"
      ],
      "title": "Module",
      "type": "object"
    },
    "NotebookSurface": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "primary",
            "supporting",
            "reference"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "type": {
          "const": "notebook",
          "title": "Type",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Label",
          "type": "string"
        },
        "path": {
          "maxLength": 1024,
          "minLength": 1,
          "pattern": "^(?!/)(?![\\s\\S]*[:\\\\\\x00-\\x1f\\x7f])(?![\\s\\S]*(?:^|/)(?:\\.{1,2})(?:/|$))[^/]+(?:/[^/]+)*(?![\\s\\S])",
          "title": "Path",
          "type": "string"
        },
        "selector": {
          "discriminator": {
            "mapping": {
              "cell_ids": "#/$defs/CellIdsSelector",
              "cell_tags": "#/$defs/CellTagsSelector",
              "whole_notebook": "#/$defs/WholeNotebookSelector"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/WholeNotebookSelector"
            },
            {
              "$ref": "#/$defs/CellIdsSelector"
            },
            {
              "$ref": "#/$defs/CellTagsSelector"
            }
          ],
          "title": "Selector"
        }
      },
      "required": [
        "id",
        "purpose",
        "type",
        "label",
        "path",
        "selector"
      ],
      "title": "NotebookSurface",
      "type": "object"
    },
    "Objective": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "text": {
          "maxLength": 4096,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "id",
        "text"
      ],
      "title": "Objective",
      "type": "object"
    },
    "Phase": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*(?![\\s\\S])",
          "title": "Id",
          "type": "string"
        },
        "title": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": ".*\\S.*",
          "title": "Title",
          "type": "string"
        },
        "progress": {
          "enum": [
            "required",
            "optional",
            "excluded"
          ],
          "title": "Progress",
          "type": "string"
        },
        "experience": {
          "discriminator": {
            "mapping": {
              "builtin": "#/$defs/BuiltinExperience",
              "custom": "#/$defs/CustomExperience"
            },
            "propertyName": "type"
          },
          "oneOf": [
            {
              "$ref": "#/$defs/BuiltinExperience"
            },
            {
              "$ref": "#/$defs/CustomExperience"
            }
          ],
          "title": "Experience"
        },
        "surfaces": {
          "items": {
            "discriminator": {
              "mapping": {
                "external": "#/$defs/ExternalSurface",
                "html": "#/$defs/HtmlSurface",
                "markdown": "#/$defs/MarkdownSurface",
                "notebook": "#/$defs/NotebookSurface",
                "source": "#/$defs/SourceSurface",
                "terminal": "#/$defs/TerminalSurface",
                "video": "#/$defs/VideoSurface"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/HtmlSurface"
              },
              {
                "$ref": "#/$defs/MarkdownSurface"
              },
              {
                "$ref": "#/$defs/SourceSurface"
              },
              {
                "$ref": "#/$defs/NotebookSurface"
              },
              {
                "$ref": "#/$defs/VideoSurface"
              },
              {
                "$ref": "#/$defs/TerminalSurface"
              },
              {
                "$ref": "#/$defs/ExternalSurface"
              }
            ]
          },
          "maxItems": 64,
